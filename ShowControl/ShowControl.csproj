<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefaultItemExcludes>$(DefaultItemExcludes);Desktop/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="System.IO.Packaging" Version="10.0.14" />
    <Content Update="wwwroot/**/*" CopyToOutputDirectory="PreserveNewest" />
    <None Update="README.md;start.cmd;start.sh" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
